---
interface Props {
  compañia: string;
  telefono?: string;
  email?: string;
  direccion?: string;
  instagram?: string;
  facebook?: string;

}
  const { compañia, telefono, email, direccion, instagram, facebook } = Astro.props as Props;
---

<div
  class="footer-wrapper mx-auto px-4 pt-16 sm:max-w-xl md:max-w-full md:px-24 lg:max-w-6xl lg:px-8"
>
  <div class="row-gap-6 mb-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2">
      <a
        href="/"
        aria-label="Go home"
        title={compañia}
        class="footer-accent inline-flex items-center"
      >
        <span class="footer-text  text-xl font-bold tracking-wide uppercase"
          >{compañia}</span
        >
      </a>
      <div class="mt-6 lg:max-w-sm">
        <p class="footer-text text-sm">
          Sed ut perspiciatis unde omnis iste natus error sit voluptatem
          accusantium doloremque laudantium, totam rem aperiam.
        </p>
        <p class="footer-text mt-4 text-sm">
          Eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae
          vitae dicta sunt explicabo.
        </p>
      </div>
    </div>
    <div class="space-y-2 text-sm">
      <p class="footer-text text-base font-bold tracking-wide">Contacto</p>
      <div class="flex">
        <p class="footer-text mr-1">Teléfono:</p>
        {telefono ? (
          <a
            href={`tel:${telefono}`}
            aria-label={`Nuestro teléfono: ${telefono}`}
            title={`Nuestro teléfono: ${telefono}`}
            class="footer-link">{telefono}</a>
        ) : (
          <span class="footer-muted">—</span>
        )}
      </div>
      <div class="flex">
        <p class="footer-text mr-1">Email:</p>
        {email ? (
          <a
            href={`mailto:${email}`}
            aria-label={`Nuestro email: ${email}`}
            title={`Nuestro email: ${email}`}
            class="footer-link">{email}</a>
        ) : (
          <span class="footer-muted">—</span>
        )}
      </div>
      <div class="flex">
        <p class="footer-text mr-1">Dirección:</p>
        {direccion ? (
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccion)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Nuestra dirección: ${direccion}`}
            title={`Nuestra dirección: ${direccion}`}
            class="footer-link"
          >
            {direccion}
          </a>
        ) : (
          <span class="footer-muted">—</span>
        )}
      </div>
    </div>
    <div>
      <span class="footer-text text-base font-bold tracking-wide">Redes Sociales</span>
      <div class="mt-1 flex items-center space-x-3">
        {instagram ? (
          <a href={instagram} class="footer-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5">
              <path
                d="M24,4.6c-0.9,0.4-1.8,0.7-2.8,0.8c1-0.6,1.8-1.6,2.2-2.7c-1,0.6-2,1-3.1,1.2c-0.9-1-2.2-1.6-3.6-1.6 c-2.7,0-4.9,2.2-4.9,4.9c0,0.4,0,0.8,0.1,1.1C7.7,8.1,4.1,6.1,1.7,3.1C1.2,3.9,1,4.7,1,5.6c0,1.7,0.9,3.2,2.2,4.1 C2.4,9.7,1.6,9.5,1,9.1c0,0,0,0,0,0.1c0,2.4,1.7,4.4,3.9,4.8c-0.4,0.1-0.8,0.2-1.3,0.2c-0.3,0-0.6,0-0.9-0.1c0.6,2,2.4,3.4,4.6,3.4 c-1.7,1.3-3.8,2.1-6.1,2.1c-0.4,0-0.8,0-1.2-0.1c2.2,1.4,4.8,2.2,7.5,2.2c9.1,0,14-7.5,14-14c0-0.2,0-0.4,0-0.6 C22.5,6.4,23.3,5.5,24,4.6z"
              ></path>
            </svg>
          </a>
        ) : null}
        {facebook ? (
          <a href={facebook} class="footer-icon">
            <svg viewBox="0 0 30 30" fill="currentColor" class="h-6">
              <circle cx="15" cy="15" r="4"></circle>
              <path
                d="M19.999,3h-10C6.14,3,3,6.141,3,10.001v10C3,23.86,6.141,27,10.001,27h10C23.86,27,27,23.859,27,19.999v-10   C27,6.14,23.859,3,19.999,3z M15,21c-3.309,0-6-2.691-6-6s2.691-6,6-6s6,2.691,6,6S18.309,21,15,21z M22,9c-0.552,0-1-0.448-1-1   c0-0.552,0.448-1,1-1s1,0.448,1,1C23,8.552,22.552,9,22,9z"
              ></path>
            </svg>
          </a>
        ) : null}
      </div>
      <p class="footer-muted mt-4 text-sm">
        Bacon ipsum dolor amet short ribs pig sausage prosciutto chicken spare
        ribs salami.
      </p>
    </div>
  </div>
  <div
    class="footer-border flex flex-col-reverse justify-between pt-5 pb-10 lg:flex-row"
  >
    <p class="footer-muted text-sm">
      © Copyright 2020 {compañia}. Todos los derechos reservados.
    </p>
    <ul
      class="mb-3 flex flex-col space-y-2 sm:flex-row sm:space-y-0 sm:space-x-5 lg:mb-0"
    >
      <li>
        <a href="faq" class="footer-link text-sm">F.A.Q</a>
      </li>
      <li>
        <a href="privacidad" class="footer-link text-sm">Política de Privacidad</a>
      </li>
      <li>
        <a href="terminos" class="footer-link text-sm">Términos y Condiciones</a>
      </li>
    </ul>
  </div>
</div>

<style>
  .footer-text {
    color: var(--texto);
  }

  .footer-muted {
    color: color-mix(in srgb, var(--texto) 60%, transparent);
  }

  .footer-link {
    color: var(--primario);
    transition: opacity 0.3s ease;
  }

  .footer-link:hover {
    opacity: 0.75;
  }

  .footer-accent {
    color: var(--primario);
  }

  .footer-icon {
    color: color-mix(in srgb, var(--texto) 50%, transparent);
    transition: color 0.3s ease;
  }

  .footer-icon:hover {
    color: var(--primario);
  }

  .footer-border {
    border-top: 1px solid color-mix(in srgb, var(--texto) 20%, transparent);
  }
</style>
