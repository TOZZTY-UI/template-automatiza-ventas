---
import Button from "../components/UI/button.astro";
import Texto from "../components/UI/texto.astro";
import Titulo from "../components/UI/titulo.astro";
---

<div class="container mx-auto px-64">
    <div class="grid grid-cols-1 grid-cols-2 items-center gap-8">
        <div class="md:pr-8">
            <Titulo
                text="Deja de perder clientes: automatiza tus ventas en 7 días"
            />
            <Texto
                class="pt-4 pb-4"
                text="Descube Implemento un sistema que capta leads, hace seguimiento automático y recibe pagos sin que tengas que mover un dedo. Tú céntrate en tu negocio. El sistema trabaja por ti."
            />

            <div class="flex items-start gap-4 flex-wrap">
                <Button
                    class="justify-self-auto"
                    style="background-color: var(--color-boton); font-family: var(--font-titulo);"
                    text="Quiero mi diagnóstico gratuito"
                    href="/diagnostic"
                />
                <Button
                    class="justify-self-auto"
                    style="border: 2px solid var(--color-boton); background-color: var(--background-color); font-family: var(--font-titulo); color: var(--color-boton);"
                    text="Ver cómo funciona"
                    href="/how-it-works"
                />
            </div>
        </div>

          <div class="scale-150 drop-shadow-xl/50" >
    <!-- 2. SVG con clipPath + imagen encima -->
    <svg class="blob-svg" viewBox="-120 -120 240 240" xmlns="http://www.w3.org/2000/svg">
